# Quy uoc dinh dang tep, ap dung cho moi editor co ho tro EditorConfig.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Markdown dung hai khoang trang cuoi dong de xuong dong, nen khong cat.
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.tex]
indent_size = 2

[Makefile]
indent_style = tab
